{
  "name": "@sharadox/graphical-user-interface-web-library",
  "version": "0.2.0",
  "description": "One generic, accessible, fully configurable component library: every interface piece in every variant, color, corner, line, size and state, styled from a single source of truth that each brand configures.",
  "private": false,
  "license": "SEE LICENSE IN LICENCA.md",
  "author": "Sharadox <contact@sharadox.com>",
  "type": "module",
  "exports": {
    "./*/type": {
      "sharadox-source": "./source/*/type.ts",
      "types": "./distribution/*/type.d.ts"
    },
    "./*": {
      "sharadox-source": [
        "./source/*/index.ts",
        "./source/*/index.tsx"
      ],
      "types": "./distribution/*/index.d.ts",
      "default": "./distribution/*/index.js"
    }
  },
  "files": [
    "distribution",
    "LICENCA.md",
    "LICENSE.md",
    "NOTICE.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.34.9",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "library-build",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run --coverage",
    "test:benchmark": "vitest bench --run --passWithNoTests",
    "documentation": "typedoc",
    "verify": "turbo run format:check lint type-check test:unit test:benchmark build",
    "prepare": "turborepo-configuration library && (husky || true)"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,md,yml,yaml,scss}": "prettier --write"
  },
  "dependencies": {
    "@sharadox/icon-web-library": "0.7.0-development.36",
    "@sharadox/style-web-library": "^0.3.1",
    "@sharadox/web-library": "^0.11.1"
  },
  "devDependencies": {
    "@sharadox/es-lint-configuration-web-library": "^0.1.3",
    "@sharadox/library-build-web-library": "^0.2.1",
    "@sharadox/prettier-configuration-web-library": "^0.1.2",
    "@sharadox/turborepo-configuration-web-library": "^0.1.4",
    "@sharadox/type-script-configuration-web-library": "^0.2.3",
    "@sharadox/vitest-configuration-web-library": "^0.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "9.39.5",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lightningcss": "1.33.0",
    "lint-staged": "^17.6.2",
    "next": "16.4.5",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.2",
    "turbo": "^2.11.13",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sharadox/graphical-user-interface-web-library.git"
  },
  "homepage": "https://github.com/Sharadox/graphical-user-interface-web-library#readme"
}
